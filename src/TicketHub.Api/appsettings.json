{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Npgsql": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  // Giá trị thật đặt qua biến môi trường / secret store, vd ConnectionStrings__DefaultConnection, JwtSettings__Secret.
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "",
    // amqp://user:password@host:5672
    "RabbitMq": ""
  },
  "JwtSettings": {
    "Issuer": "TicketHub",
    "Audience": "TicketHub",
    "Secret": "",
    "ClockSkewSeconds": 30
  },
  // Khoá ký webhook dùng chung với cổng thanh toán (>= 32 ký tự). Đặt qua biến môi trường Payments__WebhookSecret.
  "Payments": {
    "WebhookSecret": "",
    "SignatureToleranceSeconds": 300
  },
  // Máy chủ gửi email (vé). Dev dùng Mailpit; môi trường thật đặt qua biến môi trường Smtp__Host, Smtp__UserName...
  "Smtp": {
    "Host": "",
    "Port": 1025,
    "UseSsl": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@tickethub.local",
    "FromName": "TicketHub"
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshReuseGraceSeconds": 10,
    "AllowSelfRegistration": false,
    "RefreshToken": {
      "DefaultTransport": "Cookie",
      "CookieName": "tickethub_refresh",
      "CookiePath": "/api/v1/auth",
      "SameSite": "Strict"
    },
    // Tài khoản Admin đầu tiên, chỉ tạo khi bảng users còn trống. Đặt qua biến môi trường, đừng ghi ở đây.
    "SeedAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SensitivePermitLimit": 100
  },
  "Security": {
    "UseHttpsRedirection": false,
    "KnownNetworks": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenApi": {
    "Enabled": false
  }
}
